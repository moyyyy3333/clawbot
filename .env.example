# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# Stripe (use test keys to start: sk_test_... / whsec_...)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID=price_xxx        # $49 product price ID (create in Stripe dashboard)

# Public URL of the webhook server (used by Stripe + success redirect)
# Locally: use ngrok or smee.io. In prod: Railway/Render URL.
PUBLIC_URL=https://your-app.up.railway.app

# Optional: USDC wallet for crypto payment fallback
USDC_WALLET=

# Optional: support contact shown to users
SUPPORT_HANDLE=@ElCapitanNeo

# Optional: admin telegram user ID(s) for /admin commands, comma-separated
ADMIN_USER_IDS=8057854284

# Database path (sqlite)
DB_PATH=clawbot.db
